# Desenvolvimento local — copie: cp .env.example .env
# Nunca commite .env

# =============================================================================
# App
# =============================================================================
NODE_ENV=development
OFFLINE_MODE=true
CONNECTION_EXPIRY_DAYS=15
MATCH_MIN_SCORE=5
SCORE_WEIGHTS=semantic:40,tags:25,region:15,maturity:10,need:10

# =============================================================================
# Database (API no host → Postgres Docker na porta publicada)
# =============================================================================
DATABASE_URL=postgresql://cac:cac_secret@localhost:5433/cac

# =============================================================================
# Redis (API no host → Redis Docker na porta publicada)
# =============================================================================
REDIS_URL=redis://localhost:6381

# =============================================================================
# Auth / API
# =============================================================================
API_PORT=3003
JWT_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
CORS_ORIGIN=http://localhost:5178,http://localhost:5179
COOKIE_DOMAIN=localhost

# =============================================================================
# Frontends (Vite / URLs absolutas em dev)
# =============================================================================
WWW_URL=http://localhost:5179
WEB_URL=http://localhost:5178
VITE_API_URL=http://localhost:3003
VITE_WWW_URL=http://localhost:5179
VITE_WEB_URL=http://localhost:5178

# =============================================================================
# Marca
# =============================================================================
APP_BRAND_NAME="AgriZONE Connect"
APP_BRAND_SHORT=AZC
APP_BRAND_LOGO=
VITE_APP_BRAND_NAME="AgriZONE Connect"
VITE_APP_BRAND_SHORT=AZC
VITE_APP_BRAND_LOGO=

# =============================================================================
# Tipografia (www + web)
# Classes: text-extra-grande | text-grande | text-media | text-pequena | text-mini
# Papéis: extra-grande=H1 · grande=H2 seção · media=corpo/intro/título de card · pequena=nav/botões/meta · mini=labels/tags
# =============================================================================
VITE_FONT_EXTRA_GRANDE=64px
VITE_FONT_GRANDE=28px
VITE_FONT_MEDIA=18px
VITE_FONT_PEQUENA=16px
VITE_FONT_MINI=14px

# =============================================================================
# Idiomas
# =============================================================================
DEFAULT_LANG=pt
SUPPORTED_LANGS=pt,en

# =============================================================================
# Embeddings / upload
# =============================================================================
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
UPLOAD_DIR=uploads

# =============================================================================
# SMTP (vazio = log-only / jsonTransport em dev)
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@climateactionconnect.org

# =============================================================================
# Seed users
# =============================================================================
SEED_ADMIN_EMAIL=admin@cac.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_CURATOR_EMAIL=curador@cac.local
SEED_CURATOR_PASSWORD=Curador123!
