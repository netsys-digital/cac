# Ambiente local / demo no host (ajuste para DNS+HTTPS em prod real)
NODE_ENV=production
OFFLINE_MODE=true
MATCH_MIN_SCORE=60
SCORE_WEIGHTS=semantic:40,tags:25,region:15,maturity:10,need:10
CONNECTION_EXPIRY_DAYS=15

POSTGRES_USER=cac
POSTGRES_PASSWORD=cac_secret
POSTGRES_DB=cac

JWT_SECRET=prod-access-secret-change-me-min-32-chars!!
JWT_REFRESH_SECRET=prod-refresh-secret-change-me-min-32!!

# Local sem DNS — em prod use o .env.prod.example (https + .netsys.company)
PUBLIC_WWW_URL=http://localhost:8084
PUBLIC_WEB_URL=http://localhost:8086
PUBLIC_API_URL=

GATEWAY_PORT_PORTAL=8084
GATEWAY_PORT_GESTOR=8086

CORS_ORIGIN=http://localhost:8084,http://localhost:8086
COOKIE_DOMAIN=localhost

APP_BRAND_NAME=Climate Action Connect
APP_BRAND_SHORT=CAC
APP_BRAND_LOGO=

SEED_ADMIN_EMAIL=admin@cac.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_CURATOR_EMAIL=curador@cac.local
SEED_CURATOR_PASSWORD=Curador123!

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@climateactionconnect.org
