# Produção / demo hospedada — servidor NETSYS
# Copie: cp .env.prod.example .env.prod  && edite os secrets
# Nunca commite .env.prod
#
# Instalação do zero no servidor (/app/cac):
#   bash scripts/install-prod.sh

# =============================================================================
# App
# =============================================================================
NODE_ENV=production
OFFLINE_MODE=true
CONNECTION_EXPIRY_DAYS=15
MATCH_MIN_SCORE=5
SCORE_WEIGHTS=semantic:40,tags:25,region:15,maturity:10,need:10

# =============================================================================
# Database (Postgres compartilhado — rede docker "netsys")
# CAC_DB_PASSWORD é o que a API usa (obrigatório). Compose monta DATABASE_URL.
# =============================================================================
POSTGRES_USER=cac
POSTGRES_DB=cac
POSTGRES_PASSWORD=change-me-db-password
CAC_DB_PASSWORD=change-me-db-password

# =============================================================================
# Redis
# Em prod o compose aponta REDIS_URL para o serviço redis da stack.
# =============================================================================

# =============================================================================
# Auth / API
# =============================================================================
JWT_SECRET=prod-access-secret-change-me-min-32-chars!!
JWT_REFRESH_SECRET=prod-refresh-secret-change-me-min-32!!
CORS_ORIGIN=https://portalcac.netsys.company,https://gestorcac.netsys.company
COOKIE_DOMAIN=.netsys.company

# =============================================================================
# Frontends / gateway (browser). API same-origin em cada host (/api).
# PUBLIC_API_URL vazio = fetch relativo /api no host atual (portal ou gestor).
# Portas host: não conflitam com Usinup:8080, Agipoint:8081-3, Netsys:8085.
# =============================================================================
PUBLIC_WWW_URL=https://portalcac.netsys.company
PUBLIC_WEB_URL=https://gestorcac.netsys.company
PUBLIC_API_URL=
GATEWAY_PORT_PORTAL=8084
GATEWAY_PORT_GESTOR=8086

# =============================================================================
# Marca
# =============================================================================
APP_BRAND_NAME=Climate Action Connect
APP_BRAND_SHORT=CAC
APP_BRAND_LOGO=
VITE_APP_BRAND_NAME=Climate Action Connect
VITE_APP_BRAND_SHORT=CAC
VITE_APP_BRAND_LOGO=

# =============================================================================
# Tipografia (www + web — build Vite)
# Classes: text-extra-grande | text-grande | text-media | text-pequena | text-mini
# Papéis: extra-grande=H1 · grande=H2 seção · media=corpo/intro/título de card · pequena=nav/botões/meta · mini=labels/tags
# =============================================================================
VITE_FONT_EXTRA_GRANDE=64px
VITE_FONT_GRANDE=28px
VITE_FONT_MEDIA=18px
VITE_FONT_PEQUENA=16px
VITE_FONT_MINI=14px

# =============================================================================
# Idiomas
# =============================================================================
DEFAULT_LANG=pt
SUPPORTED_LANGS=pt,en

# =============================================================================
# Embeddings / upload
# =============================================================================
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
UPLOAD_DIR=uploads

# =============================================================================
# SMTP
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@climateactionconnect.org

# =============================================================================
# Seed users
# =============================================================================
SEED_ADMIN_EMAIL=admin@cac.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_CURATOR_EMAIL=curador@cac.local
SEED_CURATOR_PASSWORD=Curador123!

# TLS: certbot no nginx do host (sites-available), não no container gateway
