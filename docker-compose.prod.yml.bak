# Produção — CAC na rede netsys (Postgres/Redis compartilhados).
# Pré-requisito: docker-config no ar. Origem (cac_postgres_data) preservada.
#
#   cd /app/netsys-apps/cac
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up --build -d

name: cac

networks:
  netsys:
    external: true
    name: netsys

services:
  api:
    build:
      context: .
      dockerfile: apps/api/Dockerfile
    command: sh -c "npx prisma migrate deploy && npx prisma db seed && node dist/index.js"
    working_dir: /app/apps/api
    env_file:
      - ${ENV_FILE:-.env.prod}
    environment:
      DATABASE_URL: postgresql://cac:${CAC_DB_PASSWORD}@postgres:5432/cac
      REDIS_URL: redis://redis:6379/5
      API_PORT: '3003'
      NODE_ENV: production
      OFFLINE_MODE: ${OFFLINE_MODE:-true}
      CORS_ORIGIN: ${CORS_ORIGIN:-https://portalcac.netsys.company,https://gestorcac.netsys.company}
      COOKIE_DOMAIN: ${COOKIE_DOMAIN:-.netsys.company}
    volumes:
      - uploads_data:/app/apps/api/uploads
    networks:
      - netsys
    restart: unless-stopped
    healthcheck:
      test: ['CMD-SHELL', 'node -e "fetch(\"http://127.0.0.1:3003/health\").then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"']
      interval: 15s
      timeout: 5s
      retries: 10
      start_period: 40s

  api-worker:
    build:
      context: .
      dockerfile: apps/api/Dockerfile
    command: node dist/worker.js
    working_dir: /app/apps/api
    env_file:
      - ${ENV_FILE:-.env.prod}
    environment:
      DATABASE_URL: postgresql://cac:${CAC_DB_PASSWORD}@postgres:5432/cac
      REDIS_URL: redis://redis:6379/5
      NODE_ENV: production
      OFFLINE_MODE: ${OFFLINE_MODE:-true}
    depends_on:
      api:
        condition: service_healthy
    networks:
      - netsys
    restart: unless-stopped

  www:
    build:
      context: .
      dockerfile: apps/www/Dockerfile
      args:
        VITE_API_URL: ${PUBLIC_API_URL:-}
        VITE_WEB_URL: ${PUBLIC_WEB_URL:-https://gestorcac.netsys.company}
        VITE_WWW_URL: ${PUBLIC_WWW_URL:-https://portalcac.netsys.company}
        VITE_APP_BRAND_NAME: ${APP_BRAND_NAME:-Climate Action Connect}
        VITE_APP_BRAND_SHORT: ${APP_BRAND_SHORT:-CAC}
        VITE_APP_BRAND_LOGO: ${APP_BRAND_LOGO:-}
    depends_on:
      api:
        condition: service_healthy
    networks:
      - netsys
    restart: unless-stopped

  web:
    build:
      context: .
      dockerfile: apps/web/Dockerfile
      args:
        VITE_API_URL: ${PUBLIC_API_URL:-}
        VITE_WEB_URL: ${PUBLIC_WEB_URL:-https://gestorcac.netsys.company}
        VITE_WWW_URL: ${PUBLIC_WWW_URL:-https://portalcac.netsys.company}
        VITE_BASE: /
        VITE_APP_BRAND_NAME: ${APP_BRAND_NAME:-Climate Action Connect}
        VITE_APP_BRAND_SHORT: ${APP_BRAND_SHORT:-CAC}
        VITE_APP_BRAND_LOGO: ${APP_BRAND_LOGO:-}
    depends_on:
      api:
        condition: service_healthy
    networks:
      - netsys
    restart: unless-stopped

  gateway:
    image: nginx:1.27-alpine
    ports:
      - '${GATEWAY_PORT_PORTAL:-8084}:80'
      - '${GATEWAY_PORT_GESTOR:-8086}:81'
    volumes:
      - ./deploy/nginx/nginx.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - www
      - web
      - api
    networks:
      - netsys
    restart: unless-stopped

volumes:
  uploads_data:
    external: true
    name: cac_uploads_data
