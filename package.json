{
  "name": "cac",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @cac/api & npm run dev -w @cac/www & npm run dev -w @cac/web",
    "dev:api": "npm run dev -w @cac/api",
    "dev:www": "npm run dev -w @cac/www",
    "dev:web": "npm run dev -w @cac/web",
    "dev:worker": "npm run worker:dev -w @cac/api",
    "build": "npm run build -w @cac/shared && npm run build -w @cac/ui && npm run build -w @cac/api && npm run build -w @cac/www && npm run build -w @cac/web",
    "lint": "eslint .",
    "test": "npm run test -w @cac/api",
    "db:migrate": "npm run db:migrate -w @cac/api",
    "db:seed": "npm run db:seed -w @cac/api",
    "db:generate": "npm run db:generate -w @cac/api"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0"
  }
}
